# Copy to .env (local) and add the same values in Vercel → Settings → Environment Variables.

# Required in production. Without it the contact endpoint refuses to accept
# enquiries rather than silently dropping them.
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to the site email.
CONTACT_TO=basebondsolutions@basebondsolutions.co.za

# Must be a domain verified in Resend.
CONTACT_FROM=Basebond Solutions <website@basebondsolutions.co.za>
