---
import Icon from './Icon.astro';
import type { Faq } from '../data/faqs';

interface Props {
  faqs: Faq[];
  theme?: 'light' | 'dark';
}

const { faqs, theme = 'light' } = Astro.props;
const isDark = theme === 'dark';
---

<div class:list={['divide-y border-y', isDark ? 'divide-line-dark border-line-dark' : 'divide-line-light border-line-light']}>
  {
    faqs.map((faq, index) => (
      <details class="group py-5" open={index === 0}>
        <summary class="flex cursor-pointer items-start justify-between gap-6">
          <span
            class:list={[
              'font-body text-[1.02rem] font-semibold leading-snug',
              isDark ? 'text-cream' : 'text-ink',
            ]}
          >
            {faq.q}
          </span>
          <span
            class:list={[
              'mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full transition-transform duration-200 group-open:rotate-45',
              isDark ? 'bg-elevated text-gold' : 'bg-tint text-gold-deep',
            ]}
            aria-hidden="true"
          >
            <Icon name="plus" size={15} strokeWidth={2.2} />
          </span>
        </summary>
        <div class="pr-10 pt-3">
          <p
            class:list={[
              'font-body text-[0.94rem] leading-relaxed',
              isDark ? 'text-mist' : 'text-slate',
            ]}
          >
            {faq.a}
          </p>
        </div>
      </details>
    ))
  }
</div>
