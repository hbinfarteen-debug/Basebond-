---
import Icon from './Icon.astro';
import type { Service } from '../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const featured = Boolean(service.featured);
---

<a
  href={`/services/${service.slug}`}
  class:list={[
    'group relative flex h-full flex-col justify-between gap-6 rounded-2xl border p-6 transition-all duration-300',
    featured
      ? 'border-gold/45 bg-ink text-cream hover:border-gold'
      : 'border-line-light bg-card text-ink hover:-translate-y-1 hover:border-gold/60 hover:shadow-lg hover:shadow-ink/5',
  ]}
>
  <div>
    <div
      class:list={[
        'mb-5 flex h-11 w-11 items-center justify-center rounded-full',
        featured ? 'bg-gold text-ink' : 'bg-ink text-gold',
      ]}
    >
      <Icon name={service.icon} size={20} />
    </div>
    <h3
      class:list={[
        'font-display text-[1.2rem] font-semibold tracking-[-0.01em]',
        featured ? 'text-cream' : 'text-ink',
      ]}
    >
      {service.name}
    </h3>
    <p
      class:list={[
        'mt-2 font-body text-[0.86rem] leading-relaxed',
        featured ? 'text-mist' : 'text-slate',
      ]}
    >
      {service.short}
    </p>
  </div>

  <span
    class:list={[
      'inline-flex items-center gap-1.5 font-body text-[0.82rem] font-semibold',
      featured ? 'text-gold' : 'text-ink group-hover:text-gold-deep',
    ]}
  >
    Explore
    <Icon
      name="arrow-right"
      size={15}
      class="transition-transform duration-200 group-hover:translate-x-1"
    />
  </span>
</a>
