---
import Icon from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'outline-light' | 'outline-dark' | 'dark' | 'light' | 'ghost';
  size?: 'md' | 'lg';
  icon?: string;
  iconRight?: boolean;
  class?: string;
  type?: 'button' | 'submit';
  external?: boolean;
  ariaLabel?: string;
  fullWidth?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  iconRight = true,
  class: className = '',
  type = 'button',
  external = false,
  ariaLabel,
  fullWidth = false,
} = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-2 rounded-full font-body font-semibold transition-colors duration-200 whitespace-nowrap';

const variants: Record<string, string> = {
  primary: 'bg-gold text-ink hover:bg-[#e0a800]',
  'outline-light': 'border border-cream/25 text-cream hover:border-gold hover:text-gold',
  'outline-dark': 'border border-ink/15 text-ink hover:border-ink hover:bg-ink hover:text-cream',
  dark: 'bg-ink text-gold hover:bg-charcoal',
  light: 'bg-cream text-ink hover:bg-tint',
  ghost: 'text-ink hover:text-gold-deep',
};

const sizes: Record<string, string> = {
  md: 'px-5 py-2.5 text-label',
  lg: 'px-7 py-3.5 text-label',
};

const classes = [
  base,
  variants[variant],
  sizes[size],
  fullWidth ? 'w-full' : '',
  className,
].filter(Boolean).join(' ');

const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

{href ? (
  <a href={href} class={classes} aria-label={ariaLabel} rel={rel} target={target}>
    {icon && !iconRight && <Icon name={icon} size={18} />}
    <span><slot /></span>
    {icon && iconRight && (
      <Icon
        name={icon}
        size={18}
        class="transition-transform duration-200 group-hover:translate-x-0.5"
      />
    )}
  </a>
) : (
  <button type={type} class={classes} aria-label={ariaLabel}>
    {icon && !iconRight && <Icon name={icon} size={18} />}
    <span><slot /></span>
    {icon && iconRight && <Icon name={icon} size={18} />}
  </button>
)}
