    row2Value: 'in 11 days',
    row2Icon: 'calendar',
    row3Label: 'Site wages & retention accounts',
    row3Value: 'Retention reconciled',
    chartPathArea: 'M0,50 Q45,45 90,30 T180,38 T260,20 T340,25 T440,10 L440,65 L0,65 Z',
    chartPathLine: 'M0,50 Q45,45 90,30 T180,38 T260,20 T340,25 T440,10'
  },
  retail: {
    id: 'retail',
