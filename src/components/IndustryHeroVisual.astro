    row3Label: 'Shift payroll & tips structure',
    row3Value: 'Staff tips audited',
    chartPathArea: 'M0,46 Q50,50 110,34 T220,32 T310,16 T440,8 L440,65 L0,65 Z',
    chartPathLine: 'M0,46 Q50,50 110,34 T220,32 T310,16 T440,8'
  },
  transport: {
    id: 'transport',
    name: 'Transport & Logistics',
    icon: 'truck',
    metricLabel: 'Fuel levy & diesel refund audit',
    metricValue: '100%',
    progressPercent: 100,
    row2Label: 'Quarterly asset register review',
    row2Value: 'in 18 days',
    row2Icon: 'calendar',
    row3Label: 'Fleet depreciation & trip sheets',
    row3Value: 'Wear-and-tear filed',
