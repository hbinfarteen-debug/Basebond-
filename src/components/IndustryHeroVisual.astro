---

<div
  class="industry-hero-visual relative mx-auto flex h-[520px] w-full max-w-[640px] items-center justify-center select-none"
  data-active-index="1"
>
  <!-- Ambient Gold Glows & Depth Gradients -->
  <div
    class="pointer-events-none absolute -top-12 left-1/2 -translate-x-1/2 h-[380px] w-[500px] rounded-full bg-gradient-to-tr from-gold/15 via-gold/10 to-transparent blur-[90px]"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute bottom-4 right-10 h-[220px] w-[280px] rounded-full bg-gold/10 blur-[75px]"
    aria-hidden="true"
  ></div>

  <!-- Background Basebond Logo Triangles & Architectural Grid -->
  <svg
    viewBox="0 0 640 520"
    fill="none"
    class="pointer-events-none absolute inset-0 h-full w-full opacity-60"
    aria-hidden="true"
  >
    <!-- Logo Triangles in Faint Gold Outlines -->
    <g stroke="#F5B800" stroke-opacity="0.14" stroke-width="1.2">
      <!-- Triangle 1 (outer) -->
      <polygon points="120,130 20,410 220,410" stroke-dasharray="4 6" />
      <!-- Triangle 2 (middle) -->
      <polygon points="520,70 410,310 630,310" stroke-opacity="0.18" />
      <!-- Triangle 3 (small offset accent) -->
      <polygon points="560,110 460,320 660,320" stroke-opacity="0.08" />
      <!-- Triangle 4 (central apex) -->
      <polygon points="320,40 210,250 430,250" stroke-opacity="0.07" stroke-dasharray="2 4" />
    </g>

    <!-- Thin Dotted Connector Lines -->
    <g stroke="#FAF8F3" stroke-opacity="0.22" stroke-width="1.1" stroke-dasharray="3 5">
      <!-- Connector from Left Background Card to Center Card -->
      <line x1="160" y1="180" x2="240" y2="240" />
      <line x1="180" y1="360" x2="260" y2="340" />
      <!-- Connector from Right Background Card to Center Card -->
      <line x1="480" y1="170" x2="410" y2="230" />
      <line x1="490" y1="370" x2="420" y2="350" />
    </g>

    <!-- Connector Nodes -->
    <circle cx="160" cy="180" r="2.5" fill="#F5B800" fill-opacity="0.5" />
    <circle cx="480" cy="170" r="2.5" fill="#F5B800" fill-opacity="0.5" />
    <circle cx="240" cy="240" r="2" fill="#FAF8F3" fill-opacity="0.4" />
    <circle cx="410" cy="230" r="2" fill="#FAF8F3" fill-opacity="0.4" />
  </svg>

  <!-- ==================== BACKGROUND CARD: LEFT (Construction) ==================== -->
  <div
    class="industry-bg-card industry-bg-left pointer-events-none absolute left-0 top-[60px] z-10 w-[240px] select-none"
    aria-hidden="true"
  >
    <div
      class="rounded-2xl border border-white/10 bg-[#121215]/65 p-4.5 shadow-[0_20px_50px_rgba(0,0,0,0.65)] backdrop-blur-md"
      style="transform: rotate(-6deg) scale(0.92); transform-origin: center right;"
    >
      <div class="mb-3 flex items-center justify-between border-b border-white/5 pb-2.5">
        <div class="flex items-center gap-2">
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-gold/15 text-gold">
            <Icon name="hardhat" size={12} />
          </span>
          <span class="font-body text-[0.76rem] font-semibold tracking-wide text-cream/90">Construction</span>
        </div>
        <span class="font-mono text-[0.58rem] uppercase tracking-wider text-mist/60">JBCC / CIS</span>
      </div>

      <!-- Skeleton Progress Billing Chart -->
      <div class="space-y-2.5">
        <div class="flex items-center justify-between text-[0.66rem] text-mist/75">
          <span>Progress billing #08</span>
          <span class="font-mono text-gold/80">R 480k</span>
        </div>
        <div class="h-1.5 w-full overflow-hidden rounded-full bg-white/5">
          <div class="h-full w-[72%] rounded-full bg-gold/50"></div>
        </div>
        <div class="flex justify-between gap-1 pt-1.5">
          <div class="h-9 w-1/4 rounded bg-white/5 flex flex-col justify-end p-1">
            <div class="h-[40%] rounded-sm bg-white/10"></div>
          </div>
          <div class="h-9 w-1/4 rounded bg-white/5 flex flex-col justify-end p-1">
            <div class="h-[75%] rounded-sm bg-gold/30"></div>
          </div>
          <div class="h-9 w-1/4 rounded bg-white/5 flex flex-col justify-end p-1">
            <div class="h-[60%] rounded-sm bg-white/10"></div>
          </div>
          <div class="h-9 w-1/4 rounded bg-white/5 flex flex-col justify-end p-1">
            <div class="h-[90%] rounded-sm bg-gold/45"></div>
          </div>
        </div>
        <div class="flex items-center gap-1.5 pt-1 text-[0.62rem] text-mist/50">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-gold/60"></span>
          <span>Retention fund intact</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== BACKGROUND CARD: RIGHT (Retail) ==================== -->
  <div
    class="industry-bg-card industry-bg-right pointer-events-none absolute right-0 top-[90px] z-10 w-[245px] select-none"
    aria-hidden="true"
  >
    <div
      class="rounded-2xl border border-white/10 bg-[#121215]/65 p-4.5 shadow-[0_20px_50px_rgba(0,0,0,0.65)] backdrop-blur-md"
      style="transform: rotate(5deg) scale(0.92); transform-origin: center left;"
    >
      <div class="mb-3 flex items-center justify-between border-b border-white/5 pb-2.5">
        <div class="flex items-center gap-2">
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-gold/15 text-gold">
            <Icon name="store" size={12} />
          </span>
          <span class="font-body text-[0.76rem] font-semibold tracking-wide text-cream/90">Retail & POS</span>
        </div>
        <span class="font-mono text-[0.58rem] uppercase tracking-wider text-mist/60">POS Sync</span>
      </div>

      <!-- Skeleton Stock and Sales Chart -->
      <div class="space-y-2.5">
        <div class="flex items-center justify-between text-[0.66rem] text-mist/75">
          <span>Omnichannel stock</span>
          <span class="font-mono text-success/80">+14.2%</span>
        </div>
        <div class="h-1.5 w-full overflow-hidden rounded-full bg-white/5">
          <div class="h-full w-[84%] rounded-full bg-gradient-to-r from-gold/30 to-gold/60"></div>
        </div>
        <div class="flex items-center gap-1.5 pt-2">
          <svg viewBox="0 0 100 28" class="h-7 w-full stroke-gold/50 fill-none" preserveAspectRatio="none">
            <path d="M0,22 Q25,8 45,18 T75,10 T100,4" stroke-width="1.8" />
            <path d="M0,22 Q25,8 45,18 T75,10 T100,4 L100,28 L0,28 Z" fill="#F5B800" fill-opacity="0.08" stroke="none" />
          </svg>
        </div>
        <div class="flex items-center justify-between pt-0.5 text-[0.62rem] text-mist/50">
          <span>Shopify + Yoco</span>
          <span class="text-white/40">Reconciled</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== FOREGROUND CARD: MAIN GLASSMORPHISM CARD ==================== -->
  <div
    class="industry-main-card relative z-20 w-full max-w-[430px] rounded-3xl border border-white/12 bg-gradient-to-b from-[#18181D]/88 via-[#111114]/92 to-[#0E0E11]/95 p-5 sm:p-6 shadow-[0_30px_70px_-15px_rgba(0,0,0,0.85)] backdrop-blur-xl"
  >
    <!-- Soft Outer Card Glow -->
    <div
      class="pointer-events-none absolute -inset-[1px] -z-10 rounded-3xl bg-gradient-to-b from-gold/20 via-white/5 to-transparent opacity-60 blur-sm"
      aria-hidden="true"
    ></div>

    <!-- Top Row: 6 Circular Line-Icon Tabs -->
    <div class="mb-5 flex items-center justify-between gap-1.5 border-b border-white/8 pb-4">
      {
        tabs.map((tab, idx) => {
          const isDefault = tab.id === 'medical';
          return (
            <button
              type="button"
              class={`industry-tab group relative flex h-10 w-10 sm:h-11 sm:w-11 items-center justify-center rounded-full transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold ${
                isDefault
                  ? 'active bg-gold text-ink shadow-[0_0_18px_rgba(245,184,0,0.45)]'
                  : 'bg-white/[0.04] text-gold/80 hover:bg-white/[0.08] hover:text-gold border border-gold/25'
              }`}
              data-industry-id={tab.id}
              data-index={idx}
              title={tab.label}
              aria-label={`View ${tab.label} details`}
            >
              <Icon name={tab.icon} size={18} strokeWidth={2} />
              <!-- Tooltip on hover -->
              <span class="pointer-events-none absolute -bottom-7 left-1/2 -translate-x-1/2 whitespace-nowrap rounded bg-charcoal/95 px-2 py-0.5 text-[0.62rem] font-medium text-cream opacity-0 shadow-lg border border-white/10 transition-opacity duration-200 group-hover:opacity-100 z-30">
                {tab.label}
              </span>
            </button>
          );
        })
      }
    </div>

    <!-- Card Header: Title + SARS Compliant Pill Badge -->
    <div class="mb-4 flex items-center justify-between gap-3">
      <div>
        <span class="block font-mono text-[0.62rem] uppercase tracking-[0.16em] text-gold">
          Active Workspace
        </span>
        <h3 id="card-industry-title" class="font-display text-[1.28rem] font-semibold text-cream">
          Medical Practices
        </h3>
      </div>

      <!-- Pill Badge: SARS Compliant with check icon -->
      <div
        class="inline-flex items-center gap-1.5 rounded-full border border-gold/30 bg-gold/10 px-2.5 py-1 shadow-sm backdrop-blur-sm"
      >
        <span class="flex h-3.5 w-3.5 items-center justify-center rounded-full bg-gold text-ink">
          <Icon name="check" size={9} strokeWidth={3} />
        </span>
        <span class="font-mono text-[0.62rem] font-semibold uppercase tracking-wider text-gold">
          SARS Compliant
        </span>
      </div>
    </div>

    <!-- Body Metric Rows -->
    <div class="space-y-3.5">
      <!-- Row 1: Claims Accepted 98% with Gold Progress Bar -->
      <div class="rounded-xl border border-white/6 bg-white/[0.03] p-3 transition-colors">
        <div class="mb-1.5 flex items-center justify-between text-[0.8rem]">
          <span id="row1-label" class="font-body text-mist">Claims accepted</span>
          <span id="row1-value" class="font-mono font-bold text-cream">98%</span>
        </div>
        <div class="h-2 w-full overflow-hidden rounded-full bg-charcoal/80 border border-white/5">
          <div
            id="row1-progress"
            class="h-full rounded-full bg-gradient-to-r from-gold/80 to-gold shadow-[0_0_10px_rgba(245,184,0,0.4)] transition-all duration-700 ease-out"
            style="width: 98%;"
          ></div>
        </div>
      </div>

      <!-- Row 2: Next VAT201 due in 7 days with calendar icon -->
      <div class="flex items-center justify-between rounded-xl border border-white/6 bg-white/[0.03] px-3.5 py-2.5">
        <div class="flex items-center gap-2.5">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-gold/15 text-gold border border-gold/25">
            <Icon name="calendar" size={14} />
          </span>
          <span id="row2-label" class="font-body text-[0.8rem] text-mist">Next VAT201 due</span>
        </div>
        <span id="row2-value" class="font-mono text-[0.78rem] font-semibold text-gold">in 7 days</span>
      </div>

      <!-- Row 3: Payroll processed with a green tick -->
      <div class="flex items-center justify-between rounded-xl border border-white/6 bg-white/[0.03] px-3.5 py-2.5">
        <div class="flex items-center gap-2.5">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-success text-white shadow-[0_0_8px_rgba(46,204,113,0.35)]">
            <Icon name="check" size={11} strokeWidth={3} />
          </span>
          <span id="row3-label" class="font-body text-[0.8rem] text-mist">Monthly staff run</span>
        </div>
        <span id="row3-value" class="font-body text-[0.78rem] font-semibold text-cream">Payroll processed</span>
      </div>
    </div>

    <!-- Mini Area Chart in Gold and Charcoal -->
    <div class="mt-4 pt-2">
      <div class="mb-1 flex items-center justify-between text-[0.62rem] uppercase tracking-wider text-mist/60 font-mono">
        <span>Cashflow & Compliance Curve</span>
        <span class="text-gold/80">Rolling 6-Mo</span>
      </div>
      <div class="relative h-[65px] w-full overflow-hidden rounded-lg bg-charcoal/40 border border-white/5">
        <svg
          id="industry-chart-svg"
          viewBox="0 0 440 65"
          preserveAspectRatio="none"
          class="h-full w-full"
        >
          <defs>
            <linearGradient id="goldAreaGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#F5B800" stop-opacity="0.32" />
              <stop offset="100%" stop-color="#F5B800" stop-opacity="0.0" />
            </linearGradient>
          </defs>
          <!-- Grid lines -->
          <line x1="0" y1="20" x2="440" y2="20" stroke="#FAF8F3" stroke-opacity="0.05" stroke-dasharray="2 3" />
          <line x1="0" y1="42" x2="440" y2="42" stroke="#FAF8F3" stroke-opacity="0.05" stroke-dasharray="2 3" />
          
          <!-- Area -->
          <path
            id="chart-area"
            d={industriesData.medical.chartPathArea}
            fill="url(#goldAreaGrad)"
            class="transition-all duration-700 ease-in-out"
          />
          <!-- Stroke Line -->
          <path
            id="chart-line"
            d={industriesData.medical.chartPathLine}
            fill="none"
            stroke="#F5B800"
            stroke-width="2.2"
            stroke-linecap="round"
            class="transition-all duration-700 ease-in-out"
          />
        </svg>
      </div>
    </div>
  </div>
</div>

<!-- Auto-cycle and Interactive tab switching script -->
<script is:inline define:vars={{ industriesData, tabs }}>
  (function () {
    const container = document.querySelector('.industry-hero-visual');
    if (!container) return;

    const tabButtons = container.querySelectorAll('.industry-tab');
    const titleEl = container.querySelector('#card-industry-title');
    const row1Label = container.querySelector('#row1-label');
    const row1Value = container.querySelector('#row1-value');
    const row1Progress = container.querySelector('#row1-progress');
    const row2Label = container.querySelector('#row2-label');
    const row2Value = container.querySelector('#row2-value');
    const row3Label = container.querySelector('#row3-label');
    const row3Value = container.querySelector('#row3-value');
    const chartArea = container.querySelector('#chart-area');
    const chartLine = container.querySelector('#chart-line');

    let currentIndex = 1; // Default to Medical (index 1)
    let autoCycleInterval = null;

    function applyData(data) {
      if (!data) return;

      if (titleEl) titleEl.textContent = data.name;
      if (row1Label) row1Label.textContent = data.metricLabel;
      if (row1Value) row1Value.textContent = data.metricValue;
      if (row1Progress) row1Progress.style.width = data.progressPercent + '%';

      if (row2Label) row2Label.textContent = data.row2Label;
      if (row2Value) row2Value.textContent = data.row2Value;

      if (row3Label) row3Label.textContent = data.row3Label;
      if (row3Value) row3Value.textContent = data.row3Value;

      if (chartArea) chartArea.setAttribute('d', data.chartPathArea);
      if (chartLine) chartLine.setAttribute('d', data.chartPathLine);
    }

    function setActiveTab(index) {
      currentIndex = index;
      const targetTab = tabs[index];
      const data = industriesData[targetTab.id];

      tabButtons.forEach((btn, idx) => {
        if (idx === index) {
          btn.classList.add('active', 'bg-gold', 'text-ink', 'shadow-[0_0_18px_rgba(245,184,0,0.45)]');
          btn.classList.remove('bg-white/[0.04]', 'text-gold/80', 'border-gold/25');
        } else {
          btn.classList.remove('active', 'bg-gold', 'text-ink', 'shadow-[0_0_18px_rgba(245,184,0,0.45)]');
          btn.classList.add('bg-white/[0.04]', 'text-gold/80', 'border-gold/25');
        }
      });

      applyData(data);
    }

    // Set up click handlers
    tabButtons.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        setActiveTab(idx);
        isUserPaused = true;
        // Resume auto cycle after 8 seconds of inactivity
        clearInterval(autoCycleInterval);
        autoCycleInterval = setInterval(stepNext, 3000);
      });
    });

    function stepNext() {
      // Respect user's motion preferences
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        return;
      }
      const nextIdx = (currentIndex + 1) % tabs.length;
      setActiveTab(nextIdx);
    }

    // Auto-cycle every 3 seconds per specification
    autoCycleInterval = setInterval(stepNext, 3000);

    // Pause on hover
    container.addEventListener('mouseenter', () => clearInterval(autoCycleInterval));
    container.addEventListener('mouseleave', () => {
      clearInterval(autoCycleInterval);
      autoCycleInterval = setInterval(stepNext, 3000);
    });
  })();
</script>

<style>
  /* Float animations with staggered delays and varying speeds */
  @keyframes heroFloatMain {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-8px) rotate(0.4deg);
    }
  }

  @keyframes heroFloatLeft {
    0%, 100% {
      transform: translateY(0px) rotate(-6deg) scale(0.92);
    }
    50% {
      transform: translateY(-14px) rotate(-5.2deg) scale(0.92);
    }
  }

  @keyframes heroFloatRight {
    0%, 100% {
      transform: translateY(0px) rotate(5deg) scale(0.92);
    }
    50% {
      transform: translateY(-12px) rotate(5.8deg) scale(0.92);
    }
  }

  .industry-main-card {
    animation: heroFloatMain 7s ease-in-out infinite;
  }

  .industry-bg-left {
    animation: heroFloatLeft 9s ease-in-out infinite;
  }

  .industry-bg-right {
    animation: heroFloatRight 8s ease-in-out infinite;
    animation-delay: 1.2s;
  }

  @media (prefers-reduced-motion: reduce) {
    .industry-main-card,
    .industry-bg-left,
    .industry-bg-right {
      animation: none !important;
    }
  }
</style>

