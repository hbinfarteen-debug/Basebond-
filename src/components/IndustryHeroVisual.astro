---
import Icon from './Icon.astro';

interface IndustryCardData {
  id: string;
  name: string;
  icon: string;
  metricLabel: string;
  metricValue: string;
  progressPercent: number;
  row2Label: string;
  row2Value: string;
  row2Icon: string;
  row3Label: string;
  row3Value: string;
  chartPathArea: string;
