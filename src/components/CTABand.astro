---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { site, whatsappLink } from '../data/site';

interface Props {
  eyebrow?: string;
  title?: string;
  primaryLabel?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  eyebrow = 'Ready when you are',
  title = 'Let’s put your numbers in order.',
  primaryLabel = 'Book a free consultation',
  secondaryLabel = 'WhatsApp us',
  secondaryHref = whatsappLink(),
} = Astro.props;
---

<section class="relative overflow-hidden bg-gold text-ink">
  <!-- Decorative ink wedge. Content is constrained so nothing sits on it. -->
  <div
    class="pointer-events-none absolute inset-y-0 right-0 hidden w-[34%] bg-ink lg:block"
    style="clip-path: polygon(42% 0, 100% 0, 100% 100%, 0% 100%);"
    aria-hidden="true"
  >
    <div class="absolute inset-0 flex items-center justify-center">
      <svg viewBox="0 0 200 200" fill="none" class="h-56 w-56 opacity-25">
        <polygon points="100,10 190,180 10,180" stroke="#F5B800" stroke-width="1.4"></polygon>
        <polygon points="118,52 188,182 48,182" fill="#F5B800" fill-opacity="0.14"></polygon>
      </svg>
    </div>
  </div>

  <div class="container-page relative z-10 py-14 lg:py-16">
    <div class="flex flex-col gap-7 lg:max-w-[60%]">
      <div>
        <span class="mb-2 block font-body text-eyebrow uppercase text-ink/70">{eyebrow}</span>
        <h2 class="font-display text-display-lg text-ink">{title}</h2>
        <p class="mt-3 font-body text-[0.95rem] text-ink/75">{site.responsePromise}</p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <Button href="/contact" variant="dark" size="lg">
          {primaryLabel}
        </Button>
        <Button
          href={secondaryHref}
          variant="outline-dark"
          size="lg"
          icon="whatsapp"
          iconRight={false}
          external
        >
          {secondaryLabel}
        </Button>
      </div>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-ink/20 pt-5 font-body text-[0.8rem] text-ink/70">
        <span class="inline-flex items-center gap-2">
          <Icon name="clock" size={14} class="text-ink/60" />
          {site.hours}
        </span>
        <span class="inline-flex items-center gap-2">
          <Icon name="globe" size={14} class="text-ink/60" />
          Remote-first, nationwide
        </span>
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-2 underline underline-offset-2 hover:text-ink"
        >
          <Icon name="mail" size={14} class="text-ink/60" />
          {site.email}
        </a>
      </div>
    </div>
  </div>
</section>
