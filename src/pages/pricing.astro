---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FAQList from '../components/FAQList.astro';
import CTABand from '../components/CTABand.astro';
import PricingHeroVisual from '../components/PricingHeroVisual.astro';
import { pricing, pricingNote } from '../data/pricing';
import { faqs } from '../data/faqs';

const feeFaqs = [
  {
    q: 'What is included in the monthly retainer?',
    a: 'The retainer covers the recurring work listed in each package: bookkeeping and reconciliations, the statutory returns for your registrations, payroll up to the stated headcount, and reporting. Once-off work is quoted separately.',
  },
  {
    q: 'What counts as once-off work?',
    a: 'New company registrations, catch-up bookkeeping on prior periods, system migrations, year-end files for past years, and anything requiring a rebuild rather than a routine cycle.',
  },
  {
    q: 'Are these prices final?',
    a: 'No. They are indicative starting points. The final retainer depends on transaction volume, payroll headcount, the number of entities and your current compliance position — all confirmed after a free review, before any work begins.',
  },
  {
    q: 'Is there a minimum term?',
    a: 'Monthly services run month to month. We do not lock clients into annual contracts, because the work should justify itself every month.',
  },
  {
    q: 'What happens if we need more than the package allows?',
    a: 'We tell you before the invoice, not after. If volume grows past the package band, we propose a revised scope and you decide.',
  },
];

const allFaqs = [...feeFaqs, ...faqs.filter((f) => f.q.toLowerCase().includes('fees') || f.q.toLowerCase().includes('leave'))];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<BaseLayout
  title="Pricing — Monthly Accounting Retainers | Basebond Solutions"
  description="Indicative monthly retainers for bookkeeping, tax, payroll and management accounts in South Africa. Final scope confirmed after a free review."
  path="/pricing"
  schema={faqSchema}
>
  <section class="relative overflow-hidden bg-gradient-to-b from-ink to-charcoal py-16 text-cream lg:py-20">
    <div class="container-page relative z-10">
      <nav aria-label="Breadcrumb" class="mb-6 font-body text-[0.78rem] text-mist">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-gold">Home</a></li>
          <li aria-hidden="true" class="text-mist/40">/</li>
          <li><span class="text-cream">Pricing</span></li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-6 xl:col-span-7">
          <span class="mb-3 block font-body text-eyebrow uppercase text-gold">Transparent retainers</span>
          <h1 class="font-display text-display-lg text-cream">
            Know the monthly cost before you commit.
          </h1>
          <p class="mt-4 font-body text-body-lg text-mist">
            Three indicative packages. No lock-in contracts, no surprise invoices, and a
            written scope before any work starts.
          </p>
        </div>

        <div class="flex items-center justify-center lg:col-span-6 xl:col-span-5">
          <PricingHeroVisual />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream py-16 text-ink lg:py-24">
    <div class="container-page">
      <div class="grid grid-cols-1 items-stretch gap-6 lg:grid-cols-3">
        {
          pricing.map((tier) => (
            <article
              class:list={[
                'flex flex-col justify-between gap-6 rounded-2xl p-7',
                tier.featured
                  ? 'border-2 border-gold bg-ink text-cream shadow-xl'
                  : 'border border-line-light bg-card text-ink shadow-sm',
              ]}
            >
              <div class="flex flex-col gap-4">
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <h2
                      class:list={[
                        'font-display text-[1.4rem] font-semibold',
                        tier.featured ? 'text-cream' : 'text-ink',
                      ]}
                    >
                      {tier.name}
                    </h2>
                    <p class:list={['mt-1 font-body text-[0.82rem]', tier.featured ? 'text-mist' : 'text-slate']}>
                      {tier.for}
                    </p>
                  </div>
                  {tier.featured && (
                    <span class="whitespace-nowrap rounded-full bg-gold px-2.5 py-1 font-body text-[0.6rem] font-bold uppercase tracking-[0.12em] text-ink">
                      Most popular
                    </span>
                  )}
                </div>

                <div class:list={['border-y py-4', tier.featured ? 'border-line-dark' : 'border-line-light']}>
                  <span
                    class:list={[
                      'font-display text-[2rem] font-semibold tabular-nums',
                      tier.featured ? 'text-gold' : 'text-ink',
                    ]}
                  >
                    {tier.price}
                  </span>
                  <span class:list={['ml-1.5 font-body text-[0.8rem]', tier.featured ? 'text-mist' : 'text-slate']}>
                    {tier.cadence}
                  </span>
                  <span class:list={['mt-1 block font-body text-[0.72rem]', tier.featured ? 'text-mist' : 'text-slate']}>
                    Indicative, excl. VAT
                  </span>
                </div>

                <ul class="flex flex-col gap-2.5">
                  {tier.features.map((feature) => (
                    <li class="flex items-start gap-2.5">
                      <Icon
                        name="check"
                        size={15}
                        strokeWidth={2.6}
                        class:list={['mt-1 shrink-0', tier.featured ? 'text-gold' : 'text-gold-deep']}
                      />
                      <span
                        class:list={[
                          'font-body text-[0.86rem] leading-relaxed',
                          tier.featured ? 'text-cream' : 'text-ink',
                        ]}
                      >
                        {feature}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>

              <Button href="/contact" variant={tier.featured ? 'primary' : 'dark'} size="lg" fullWidth>
                {tier.cta}
              </Button>
            </article>
          ))
        }
      </div>

      <p class="mx-auto mt-8 max-w-2xl text-center font-body text-[0.82rem] leading-relaxed text-slate">
        {pricingNote}
      </p>

      <div class="mx-auto mt-12 max-w-3xl rounded-2xl border border-line-light bg-card p-7">
        <h2 class="font-display text-headline-md text-ink">How a quote is actually built</h2>
        <ol class="mt-5 flex flex-col gap-4">
          {
            [
              'A free 20-minute call to understand the entity, headcount and current setup.',
              'A review of your SARS and CIPC standing, plus the state of your books.',
              'A written scope listing exactly what is done, how often, and by when.',
              'A fixed monthly figure and a once-off figure for any catch-up work.',
            ].map((step, index) => (
              <li class="flex items-start gap-4">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink font-mono text-[0.7rem] text-gold">
                  {index + 1}
                </span>
                <span class="font-body text-[0.9rem] leading-relaxed text-slate">{step}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="border-t border-line-light bg-tint py-16 text-ink lg:py-24">
    <div class="container-page grid grid-cols-1 gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading eyebrow="Fee questions" title="What the packages do and do not cover." />
      </div>
      <div class="lg:col-span-8">
        <FAQList faqs={allFaqs} />
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>
